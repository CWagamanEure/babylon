# Babylon configuration — copy to `.env` and fill in. NEVER commit `.env`.

# Network: "mainnet" or "testnet". Start on testnet.
BABYLON_NETWORK=testnet

# Account public address (0x...). Used for read-only user data subscriptions.
BABYLON_ACCOUNT_ADDRESS=

# API wallet private key for SIGNING orders (0x...). Leave blank for data-only mode.
# Use a dedicated Hyperliquid API wallet, NOT your main wallet key.
BABYLON_SECRET_KEY=

# Where captured market data is written.
BABYLON_DATA_DIR=./data

# Log level: DEBUG / INFO / WARNING / ERROR
BABYLON_LOG_LEVEL=INFO

# Pretty console logs (true) vs JSON logs (false, for production/files).
BABYLON_LOG_CONSOLE=true
